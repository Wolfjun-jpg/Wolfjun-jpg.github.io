$("pkgs").innerHTML=Object.entries(PK).map(([k,p])=>`<article class="p"><div class="top" style="background:${p.g}">${p.e}</div><div class="pb"><div class="tag">${p.tag}</div><h3>${p.n}</h3><p>${p.d}</p><ul>${p.l.map(x=>`<li>${x}</li>`).join("")}</ul><div class="pf"><span>Desde <b>${money(p.a)}</b></span><button class="btn sm" data-pk="${k}">Reservar</button></div></div></article>`).join("");

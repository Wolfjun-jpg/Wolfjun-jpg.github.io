$("date").min=$("date").value=[t.getFullYear(),String(t.getMonth()+1).padStart(2,"0"),String(t.getDate()).padStart(2,"0")].join("-");

// Total
const nums=()=>({a:Math.max(0,parseInt($("ad").value)||0),c:Math.max(0,parseInt($("ch").value)||0)});
function total(){const p=PK[$("pkg").value],{a,c}=nums();return{p,a,c,sum:a*p.a+c*p.c}}
function update(){const{a,c,sum,p}=total();$("brk").textContent=`${a} adulto${a==1?"":"s"} × ${money(p.a)}`+(c?` + ${c} niño${c==1?"":"s"} × ${money(p.c)}`:"");$("tot").textContent=money(sum)}
["pkg","ad","ch"].forEach(i=>$(i).addEventListener("input",update));update();

// Mensajes
function msg(r){return `Hola Wolfmoon Travel, quiero confirmar mi reserva ${r.code}:\n• ${PK[r.pkg].n}\n• Fecha: ${r.date}\n• ${r.a} adulto(s), ${r.c} niño(s)\n• Total estimado: ${money(r.sum)}\n• A nombre de: ${r.name} (${r.tel})`+(r.note?`\n• Comentarios: ${r.note}`:"")}

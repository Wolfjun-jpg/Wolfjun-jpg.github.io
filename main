 save([r,...load()]);render();showOk(r);$("form").reset();$("date").value=$("date").min;$("ad").value=2;$("ch").value=0;update();
});
function showOk(r){
 $("form").classList.add("hide");const o=$("ok");o.classList.remove("hide");
 o.innerHTML=`<h3>¡Reserva registrada!</h3><div>Tu código de reserva:</div><div class="code">${r.code}</div><dl><dt>Experiencia</dt><dd>${esc(PK[r.pkg].n)}</dd><dt>Fecha</dt><dd>${esc(fdate(r.date))}</dd><dt>Viajeros</dt><dd>${r.a} adulto(s), ${r.c} niño(s)</dd><dt>Total estimado</dt><dd>${money(r.sum)}</dd><dt>A nombre de</dt><dd>${esc(r.name)}</dd></dl><div class="ra"><a class="btn" target="_blank" rel="noopener" href="${waUrl(r)}">Confirmar por WhatsApp</a><a class="btn alt" href="${mailUrl(r)}">Confirmar por correo</a><button class="btn alt" id="again">Nueva reserva</button></div><small>Tu reserva queda pendiente hasta que el equipo de Wolfmoon Travel la confirme y coordine el pago. El total es una estimación y puede ajustarse al confirmar.</small>`;
 $("again").onclick=showForm;$("reservar").scrollIntoView();
}
function showForm(){$("ok").classList.add("hide");$("form").classList.remove("hide")}

// Mis reservas
function render(){
 const l=load(),box=$("res");
 if(!l.length){box.innerHTML='<div class="empty">Aún no tienes reservas en este dispositivo.</div>';return}
 box.innerHTML=l.map(r=>`<div class="r"><div><b>${r.code} · ${esc(PK[r.pkg]?PK[r.pkg].n:"")}</b><span>${esc(fdate(r.date))} · ${r.a} adulto(s), ${r.c} niño(s) · ${money(r.sum)}</span></div><div class="ra"><span class="st ${r.status=="cancelada"?"c":""}">${r.status}</span>${r.status=="cancelada"?"":`<a class="btn sm" target="_blank" rel="noopener" href="${waUrl(r)}">WhatsApp</a><a class="btn sm alt" href="${mailUrl(r)}">Correo</a><button class="btn sm alt" data-x="${r.code}">Cancelar</button>`}</div></div>`).join("");
 box.querySelectorAll("[data-x]").forEach(b=>b.onclick=()=>{
  if(!confirm("¿Cancelar la reserva "+b.dataset.x+"?"))return;
  save(load().map(r=>r.code==b.dataset.x?{...r,status:"cancelada"}:r));render();
 });
}
render();

// Menú móvil
$("menu").onclick=()=>$("nav").classList.toggle("open");
$("nav").querySelectorAll("a").forEach(a=>a.onclick=()=>$("nav").classList.remove("open"));
</script>
</body>
</html>
